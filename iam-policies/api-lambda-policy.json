{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PresignUploadAndDeleteRaw",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::RAW_BUCKET_NAME/uploads/*"
    },
    {
      "Sid": "PresignDownloadAndDeleteClean",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::CLEAN_BUCKET_NAME/redacted/*"
    },
    {
      "Sid": "DocumentRecords",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:GetItem", "dynamodb:Query", "dynamodb:DeleteItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:ACCOUNT_ID:table/TABLE_NAME"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:ACCOUNT_ID:log-group:/aws/lambda/*ApiFunction*:*"
    }
  ]
}
